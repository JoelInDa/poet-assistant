<!--
  ~ Self-contained circular app icon (gradient disc + white eighth note) for in-app use,
  ~ e.g. the About screen. The launcher itself uses the adaptive icon in mipmap-anydpi-v26;
  ~ this mirrors it as a single drawable so views that show the icon aren't stuck with
  ~ upstream's legacy @mipmap/ic_launcher book PNG.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- gradient disc -->
    <path android:pathData="M0,54 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF607D8B" />
                <item android:offset="1" android:color="#FF263238" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- white eighth note (same shape as the launcher foreground) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,68
            a12,12 0 1,0 24,0
            a12,12 0 1,0 -24,0 z
            M53,28 h5 v40 h-5 z
            M58,27
            c13,2 17,13 11,24
            c1,-11 -3,-18 -11,-20 z" />
</vector>
