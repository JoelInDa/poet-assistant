<!--
  ~ jLyrics Assistant launcher background: a blue-grey diagonal gradient, on-brand with the
  ~ app's primary colour and deliberately not white, so it stands apart from upstream's
  ~ white-background book icon on the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF607D8B" />
                <item android:offset="1" android:color="#FF263238" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
