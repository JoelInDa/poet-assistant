<!--
  A single result rendered as a pill. Under FlexboxLayoutManager these wrap and pack
  several per line, reclaiming the horizontal space upstream spent on the R/T/D icons
  and per-row star. Tapping the pill searches that word in the current mode;
  long-pressing opens the cross-mode / favorite / share menu (wired in RTListAdapter).
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="ca.rmen.android.poetassistant.main.dictionaries.rt.RTEntryViewModel" />
    </data>

    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/bg_word_chip"
        android:activated="@{viewModel.isFavorite}"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/min_touch_target"
        android:minWidth="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.App.BodyLarge"
        android:text="@{viewModel.text}"
        tools:text="happy" />
</layout>
